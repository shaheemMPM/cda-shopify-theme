{% doc %}
  Renders a collection card using its image, heading, description and collection settings.
  Falls back to the collection's featured image when no custom image is selected.
  @example
  Render as a dynamic block in the Build your workday section.
{% enddoc %}

{% liquid
  assign card_collection = block.settings.collection
  assign card_image = block.settings.image | default: card_collection.featured_image
  assign card_heading = block.settings.heading | default: card_collection.title
  assign image_loading = 'eager'
  if section.index > 2
    assign image_loading = 'lazy'
  endif
%}

{% capture card_content %}
  <div class="workday-card__media">
    {% if card_image != blank %}
      {{
        card_image
        | image_url: width: 1440
        | image_tag:
          widths: '360, 540, 720, 960, 1200, 1440',
          sizes: '(min-width: 750px) calc((100vw - 144px) / 3), calc(100vw - 32px)',
          loading: image_loading,
          class: 'workday-card__image',
          alt: ''
      }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag: 'workday-card__image workday-card__placeholder' }}
    {% endif %}
  </div>

  <div class="workday-card__copy">
    {% if card_heading != blank %}
      <h3 id="WorkdayCardHeading-{{ block.id }}" class="workday-card__heading h4">
        {{ card_heading | escape }}
      </h3>
    {% endif %}
    {% if block.settings.description != blank %}
      <p class="workday-card__description">{{ block.settings.description | escape | newline_to_br }}</p>
    {% endif %}
    {% if card_collection != blank %}
      <span id="WorkdayCardLink-{{ block.id }}" class="workday-card__cta">
        {% if block.settings.link_label != blank %}
          {{ block.settings.link_label | escape }}
        {% else %}
          {{ card_collection.title | escape }}
        {% endif %}
        <span class="workday-card__arrow" aria-hidden="true">&rarr;</span>
      </span>
    {% endif %}
  </div>
{% endcapture %}

<article
  class="workday-card"
  style="--workday-card-radius: {{ settings.card_corner_radius }}px;"
  {{ block.shopify_attributes }}
>
  {% if card_collection != blank %}
    <a
      class="workday-card__content"
      href="{{ card_collection.url }}"
      aria-labelledby="{% if card_heading != blank %}WorkdayCardHeading-{{ block.id }} {% endif %}WorkdayCardLink-{{ block.id }}"
    >
      {{ card_content }}
    </a>
  {% else %}
    <div class="workday-card__content">{{ card_content }}</div>
  {% endif %}
</article>

{% stylesheet %}
  .workday-card {
    min-width: 0;
  }

  .workday-card__content {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: var(--gap-2xl);
    color: var(--color-foreground);
    text-decoration: none;
    border-radius: var(--workday-card-radius);
  }

  .workday-card__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--palette-lightest);
    border-radius: var(--workday-card-radius);
  }

  .workday-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .workday-card__placeholder {
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  .workday-card__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-md);
    overflow-wrap: anywhere;
  }

  .workday-card__heading,
  .workday-card__description {
    margin: 0;
  }

  .workday-card__description {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .workday-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    min-height: var(--minimum-touch-target);
    margin-block-start: auto;
    padding-block-start: var(--padding-xs);
    font-weight: var(--font-subheading--weight);
    text-underline-offset: 0.25em;
  }

  .workday-card__content:is(:hover, :focus-visible) .workday-card__cta {
    text-decoration: underline;
  }

  [dir='rtl'] .workday-card__arrow {
    transform: scaleX(-1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:workday.image_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:names.description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.label"
    }
  ],
  "presets": [{ "name": "t:names.collection_card" }]
}
{% endschema %}
