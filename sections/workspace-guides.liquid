{% comment %}
  Lists up to 12 active Workspace guide metaobjects with their native page URLs.
  The current guide is omitted when this section appears on a guide page.
  @example
  Add Workspace guides to the homepage or a metaobject template.
{% endcomment %}

{% capture guide_cards %}
  {% for guide in metaobjects.workroom_guide.values limit: 12 %}
    {% if guide.system.url != blank and guide.system.id != metaobject.system.id %}
      <article class="workspace-guides__card">
        <p class="workspace-guides__eyebrow">{{ 'workspace_guides.eyebrow' | t }}</p>
        <h3 class="workspace-guides__title h3">
          <a class="workspace-guides__link" href="{{ guide.system.url }}">{{ guide.title.value | escape }}</a>
        </h3>
        {% if guide.summary.value != blank %}
          <p class="workspace-guides__summary">{{ guide.summary.value | escape }}</p>
        {% endif %}
        <span class="workspace-guides__cta" aria-hidden="true">{{ 'workspace_guides.read_guide' | t }} <span>&rarr;</span></span>
      </article>
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign guide_cards = guide_cards | strip %}

{% if guide_cards != blank or request.design_mode %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
  <div class="section-background color-custom-{{ section.id }}"></div>
  <section class="section section--page-width workspace-guides color-custom-{{ section.id }}" style="--guide-radius: {{ settings.card_corner_radius }}px;">
    {% if section.settings.heading != blank %}
      <h2 class="workspace-guides__heading h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="workspace-guides__intro">{{ section.settings.subheading | escape }}</p>
    {% endif %}
    {% if guide_cards != blank %}
      <div class="workspace-guides__grid">{{ guide_cards }}</div>
    {% else %}
      <p>{{ 'workspace_guides.empty_editor' | t }}</p>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .workspace-guides {
    padding-block: clamp(var(--padding-5xl), 6vw, calc(var(--padding-6xl) * 1.5));
    overflow-wrap: anywhere;
  }

  .workspace-guides__heading,
  .workspace-guides__title {
    margin: 0;
  }

  .workspace-guides__intro {
    max-width: 42rem;
    margin-block: var(--margin-lg) 0;
    color: var(--color-foreground-muted);
  }

  .workspace-guides__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--gap-xl);
    margin-block-start: var(--gap-3xl);
  }

  .workspace-guides__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(var(--padding-xl), 3vw, var(--padding-3xl));
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: var(--guide-radius);
  }

  .workspace-guides__eyebrow {
    margin-block: 0 var(--margin-2xl);
    font-size: var(--font-size--xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-foreground-muted);
  }

  .workspace-guides__link {
    color: inherit;
    text-decoration: none;
  }

  .workspace-guides__link::after {
    position: absolute;
    inset: 0;
    border-radius: var(--guide-radius);
    content: '';
  }

  .workspace-guides__card:focus-within {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .workspace-guides__summary {
    margin-block: var(--margin-lg) var(--gap-3xl);
    color: var(--color-foreground-muted);
  }

  .workspace-guides__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-lg);
    margin-block-start: auto;
    font-weight: var(--font-subheading--weight);
    text-underline-offset: 0.25em;
  }

  .workspace-guides__card:is(:hover, :focus-within) .workspace-guides__cta {
    text-decoration: underline;
  }

  [dir='rtl'] .workspace-guides__cta > span {
    transform: scaleX(-1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:workspace_guides.name",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "paragraph", "content": "t:workspace_guides.info" },
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "t:workspace_guides.heading" },
    { "type": "textarea", "id": "subheading", "label": "t:names.subheading", "default": "t:workspace_guides.subheading" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "default": "#f7f4ed" }
  ],
  "presets": [{ "name": "t:workspace_guides.name", "category": "t:categories.text" }]
}
{% endschema %}
